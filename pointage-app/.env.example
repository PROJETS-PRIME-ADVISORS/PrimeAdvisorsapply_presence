# Copier ce fichier en .env (jamais versionné) puis renseigner les valeurs.

# Mot de passe de la page /admin (12 caractères minimum en production).
ADMIN_PASSWORD=

# Clé qui signe le cookie de session (32 caractères minimum en production). Pour en générer une :
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Base Postgres de production, fournie automatiquement par l'intégration Neon sur Vercel.
# Laisser vide en local : les pointages sont alors enregistrés dans pointage.db (SQLite).
DATABASE_URL=

# Délai minimal, en minutes, entre l'arrivée et le départ (évite qu'un double scan clôture la journée).
DELAI_MIN_DEPART_MINUTES=30

# Port du serveur local (python app.py).
PORT=5000
